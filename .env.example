# Copy to .env.local (gitignored). Used by .cursor/mcp.json for Google Sheets MCP.
# Requires: Google Cloud project + Sheets API + service account JSON key.

GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\chris\.config\corp-civ-idle\google-sheets-sa.json

# From the sheet URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
CORP_CIV_SPREADSHEET_ID=

# Firebase web app config (Online multiplayer)
# Also enable Authentication → Anonymous sign-in in Firebase Console.
# Deploy firestore.rules before test mode expires — see docs/firestore-security.md
# Dev online shortcuts (optional — from scripts/create-access-key.mjs):
# VITE_ONLINE_DEV_KEY_TIM=
# VITE_ONLINE_DEV_KEY_CHRIS=
# VITE_ONLINE_ALLOW_ANONYMOUS=true  # dev only — legacy; production uses Google sign-in
# VITE_ACCOUNT_GATE_OFFLINE=false  # dev only — hide Tim/Chris offline picker (preview playtester gate)
# Web client ID from Firebase Console → Authentication → Google (same as OAuth client)
# Real value only — do NOT copy this line verbatim (placeholder causes Google error 401 invalid_client)
# VITE_GOOGLE_OAUTH_CLIENT_ID=<from Firebase Authentication → Google → Web client ID>
# VITE_GOOGLE_SIGNIN_REDIRECT=true  # optional — full-page OAuth in Chrome only; not for Cursor preview
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
